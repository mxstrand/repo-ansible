# [[ repo_managed ]]
name: Review

on:
  pull_request_target:
    types: [opened, reopened, synchronize]
  # Inert unless the repo enables a merge queue via a branch ruleset; then required checks run on queue branches too.
  merge_group:
  workflow_call:

jobs:
  commit-conventions:
    runs-on: ubuntu-latest
    # Don't enforce commit conventions checks for Dependabot.
    # merge_group events carry no pull_request payload, which these actions need to look up the PR's commits;
    # commit messages were already checked on the PR itself.
    if: github.event_name != 'merge_group' && github.actor != 'dependabot[bot]'
    continue-on-error: true
    steps:
        # v6 https://github.com/actions/checkout/commit/de0fac2e4500dabe0009e67214ff5f5447ce83dd
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          persist-credentials: false

      # interesting alternative: https://github.com/cocogitto/cocogitto
        # v1.3.0 https://github.com/webiny/action-conventional-commits/commit/8bc41ff4e7d423d56fa4905f6ff79209a78776c7
      - uses: webiny/action-conventional-commits@8bc41ff4e7d423d56fa4905f6ff79209a78776c7
{% if repo.github.workflows.review_card_check %}

      - name: Check Card# reference
        # v1 https://github.com/linkorb/commit-message-checker/commit/dc804b50ce575a720739ec3f0ef3d5030130ec98
        uses: linkorb/commit-message-checker@dc804b50ce575a720739ec3f0ef3d5030130ec98
        with:
          # Accepts a card number or a Jira issue key, optionally with a PR reference:
          #   #1234    NEB-123    #1234 (#20)
          pattern: '(#\d{4,5}|[A-Z][A-Z0-9]+-\d+)(\s+\(#\d+\))?$'
          flags: 'gm'
          error: 'Your commit message has to end with a card number like "#1234" or a Jira issue key like "NEB-123".'
          excludeDescription: 'true' # optional: this excludes the description body of a pull request
          excludeTitle: 'true' # optional: this excludes the title of a pull request
          checkAllCommitMessages: 'true' # optional: this checks all commits associated with a pull request
          accessToken: ${{ secrets.GITHUB_TOKEN }} # github access token is only required if checkAllCommitMessages is true
{% endif %}

{% if enable_reviewdog %}
  code-quality:
    runs-on: ubuntu-latest
    # reviewdog's pull-request mode needs a pull request context, which merge queue branches don't have
    if: github.event_name != 'merge_group'
    steps:
        # v6 https://github.com/actions/checkout/commit/de0fac2e4500dabe0009e67214ff5f5447ce83dd
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          persist-credentials: false
      - name: latest repo-ansible/reviewdog container
        run: docker pull ghcr.io/linkorb/repo-ansible/reviewdog:latest
      - name: run reviewdog checks
        run: docker run --rm -v "$PWD":/app:z ghcr.io/linkorb/repo-ansible/reviewdog:latest pull-request
{% endif %}
{% if workflow_group in followup_workflows %}
{% for followup_workflow in followup_workflows[workflow_group] %}

  [[ followup_workflow.name ]]-followup:
    # On merge_group events commit-conventions is skipped, but the followup checks must still run
    # and report so the merge queue can merge. Dependabot PRs keep skipping followups as before.
    if: ${{ !cancelled() && (needs.commit-conventions.result != 'skipped' || github.event_name == 'merge_group') }}
    needs: commit-conventions
    secrets: inherit
    uses: ./[[ followup_workflow.path_from_root ]]
{% endfor %}
{% endif %}
